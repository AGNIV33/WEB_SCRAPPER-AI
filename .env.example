# Get a free key at https://build.nvidia.com (click your profile > API Keys)
NVIDIA_API_KEY=
# Optional: change the model (any chat model listed on build.nvidia.com)
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Used if the main model fails
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional (local only): path to Chrome if not auto-found
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Login + history (Firebase). Leave empty to run without login.
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration (Config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Rate limiting (on automatically on Vercel). Optional, for exact limits across servers: free Upstash Redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# AI_DAILY_LIMIT=300
# Admin accounts: every feature, no limits (comma separated, must be a verified email)
ADMIN_EMAILS=
